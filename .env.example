# ============================================================
# Clara — Venta automatizada de seguros (Colsubsidio × 30X)
# Copia este archivo como .env y completa los valores.
# NUNCA subas el .env real a git ni al hosting (usa secrets).
# Última actualización: 23 de julio de 2026
# ============================================================

# --- Proveedor de LLM ---
# Vacío => se detecta por las claves presentes:
#   · GEMINI_API_KEY (AIza... de AI Studio o AQ. de Vertex Express) => Gemini
#   · ANTHROPIC_API_KEY (sk-ant-...) => Claude primario, con Gemini de RESPALDO
#     automático si además hay clave Gemini.
#   · ollama => modelo por endpoint compatible con OpenAI (ver abajo).
LLM_PROVIDER=

# --- Gemini (proveedor principal de la demo) ---
# Crea tu clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Anthropic / Claude (opcional) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Parámetros del modelo ---
LLM_TEMPERATURE=0.4
# Sube a 120 con modelos locales: la primera petición carga el modelo en memoria.
LLM_TIMEOUT=60

# --- Modelo por endpoint compatible con OpenAI (LLM_PROVIDER=ollama) ---
#   1) Local con Ollama (el dato no sale de la máquina):
#      OLLAMA_BASE_URL=http://localhost:11434/v1 · OLLAMA_MODEL=qwen3:4b
#   2) Router de Hugging Face (sin GPU propia):
#      OLLAMA_BASE_URL=https://router.huggingface.co/v1 + HF_TOKEN=hf_...
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:4b
HF_TOKEN=

# --- Servidor ---
# development | production
APP_ENV=development
PORT=8000
LOG_LEVEL=INFO

# URL pública base para enlaces (pago y PDFs).
# Local: http://localhost:8000 · En Hugging Face Spaces se detecta sola (SPACE_HOST).
PUBLIC_BASE_URL=http://localhost:8000

# Horas de inactividad tras las cuales se purga una sesión persistida.
SESSION_TTL_HOURS=24

# --- MongoDB (afiliados, sesiones, solicitudes) ---
# Local con Docker: docker compose up -d  (sin autenticación, solo demo)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=colsubsidio

# --- Correo (SMTP) para entrega real del PDF (opcional; si falta, se simula) ---
# Gmail: activa verificación en 2 pasos y crea una "Contraseña de aplicación".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Clara - Colsubsidio Seguros <no-reply@colsubsidio.demo>

# --- Twilio (opcional, WhatsApp/SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=
