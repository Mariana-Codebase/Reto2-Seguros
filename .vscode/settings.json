{
  // Clara — Colsubsidio × 30X · configuración del workspace
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoImportCompletions": true,
  "editor.rulers": [100],
  "files.eol": "
",
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "var/": true
  },
  "files.watcherExclude": {
    "**/var/**": true
  },
  "[python]": {
    "editor.tabSize": 4
  },
  "[json]": {
    "editor.tabSize": 2
  }
}
