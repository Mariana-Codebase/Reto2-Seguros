{
  "name": "Colsubsidio · Cody · Activación proactiva",
  "nodes": [
    {
      "parameters": {
        "content": "## Cody · activación proactiva\nConecta eventos del ecosistema Colsubsidio con el agente Cody.\n\n**Contrato del flujo**\n1. El webhook recibe `{serie, evento, datos?}`.\n2. `Normalizar evento` crea un payload estable y un `trace_id` para seguir la ejecución.\n3. n8n llama a `POST /api/eventos`; Cody decide la acción con reglas, propensión y anti-spam.\n4. La respuesta devuelve la decisión y la misma trazabilidad al sistema de origen.\n\nLa inteligencia comercial vive en Cody. n8n transporta, agenda y hace observable la comunicación.",
        "height": 260,
        "width": 380
      },
      "id": "note1",
      "name": "Cómo funciona",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [220, 80]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "colsubsidio-evento",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wh1",
      "name": "Evento de otra base",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [260, 400],
      "webhookId": "colsubsidio-evento"
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "serie", "name": "serie", "value": "={{ $json.body?.serie ?? $json.serie ?? '' }}", "type": "string" },
            { "id": "evento", "name": "evento", "value": "={{ $json.body?.evento ?? $json.evento ?? '' }}", "type": "string" },
            { "id": "datos", "name": "datos", "value": "={{ $json.body?.datos ?? $json.datos ?? {} }}", "type": "object" },
            { "id": "enviar", "name": "enviar", "value": true, "type": "boolean" },
            { "id": "source", "name": "source", "value": "n8n", "type": "string" },
            { "id": "trace-id", "name": "trace_id", "value": "={{ $json.headers?.['x-trace-id'] ?? $execution.id }}", "type": "string" }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "set-normalize",
      "name": "Normalizar evento",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [520, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CLARA_BASE_URL }}/api/eventos",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { serie: $json.serie, evento: $json.evento, datos: $json.datos, enviar: $json.enviar, source: $json.source, trace_id: $json.trace_id } }}",
        "options": { "timeout": 10000 }
      },
      "id": "http1",
      "name": "Cody · decidir acción",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [800, 400]
    },
    {
      "parameters": {
        "respondWith": "firstIncomingItem",
        "options": { "responseCode": 200 }
      },
      "id": "resp1",
      "name": "Responder a la base",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [1080, 400]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "0 9 * * *" }
          ]
        }
      },
      "id": "cron1",
      "name": "Cada día · 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [260, 640]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CLARA_BASE_URL }}/api/ofertas/barrido",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"muestra\": 25\n}",
        "options": {}
      },
      "id": "http2",
      "name": "Barrido autónomo de ofertas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [560, 640]
    }
  ],
  "connections": {
    "Evento de otra base": {
      "main": [[{ "node": "Normalizar evento", "type": "main", "index": 0 }]]
    },
    "Normalizar evento": {
      "main": [[{ "node": "Cody · decidir acción", "type": "main", "index": 0 }]]
    },
    "Cody · decidir acción": {
      "main": [[{ "node": "Responder a la base", "type": "main", "index": 0 }]]
    },
    "Cada día · 09:00": {
      "main": [[{ "node": "Barrido autónomo de ofertas", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
